extends SceneTree
## Puzzle generator (BUILD_PLAN.md task 4.2). Plays varied self-play games, then keeps
## only positions with a proven forced solution AND exactly one correct first move.
## Writes games/aadupuli/puzzles/puzzle_data.gd.
##
## From the repository root:
##   godot --headless --path game -s res://tools/make_puzzles.gd -- --games=300

const R := preload("res://games/aadupuli/rules/aadupuli_rules.gd")
const OUT := "res://games/aadupuli/puzzles/puzzle_data.gd"
const PER_TYPE_MAX := {"safe": 70, "capture2": 70, "trap1": 50, "trap2": 50}


func _init() -> void:
	var games := 300
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--games="):
			games = int(arg.trim_prefix("--games="))
	var start := Time.get_ticks_msec()
	var seen := {}
	var found := {"safe": [], "capture2": [], "trap1": [], "trap2": []}
	var tigers := AadupuliOpponent.new(11)
	var goats := AadupuliOpponent.new(12)
	var checked := 0
	for g in games:
		var s := R.new_game()
		var n := 0
		while R.result(s) == R.ONGOING and n < 200:
			var ai := tigers if s.turn == R.TIGER else goats
			s = R.apply(s, ai.search(s, 2, 150, 0.3, 4))
			n += 1
			var key := "%d/%d" % [R.position_key(s), s.captured]
			if seen.has(key) or R.result(s) != R.ONGOING:
				continue
			seen[key] = true
			checked += 1
			_consider(s, found)
		if g % 25 == 24:
			print("  %d games, %d positions checked, found: safe %d, capture in 2 %d, trap in 1 %d, trap in 2 %d (%d s)" % [
				g + 1, checked, found["safe"].size(), found["capture2"].size(), found["trap1"].size(), found["trap2"].size(),
				(Time.get_ticks_msec() - start) / 1000])
	var puzzles: Array = []
	for kind: String in ["safe", "trap1", "capture2", "trap2"]:
		var list: Array = found[kind]
		list.shuffle()
		puzzles.append_array(list.slice(0, PER_TYPE_MAX[kind]))
	puzzles.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a["difficulty"] < b["difficulty"])
	for i in puzzles.size():
		puzzles[i]["id"] = i + 1
	_write(puzzles)
	print("Wrote %d puzzles to %s in %d s" % [puzzles.size(), OUT, (Time.get_ticks_msec() - start) / 1000])
	quit()


func _consider(s: R.State, found: Dictionary) -> void:
	var p := s.copy()
	p.quiet = 0
	p.counts = {R.position_key(p): 1}
	var legal := R.legal_moves(p)
	if p.turn == R.TIGER:
		if AadupuliPuzzles.capture_now(p):
			return
		var wins := AadupuliPuzzles.capture_wins(p, 2)
		if wins.size() == 1:
			found["capture2"].append(_record(p, "capture", 2, wins[0], 4 if legal.size() >= 10 else 3))
		return
	var safe := AadupuliPuzzles.safe_moves(p)
	if safe.size() == 1 and legal.size() >= 5:
		found["safe"].append(_record(p, "safe", 1, safe[0], 1 if legal.size() <= 8 else 2))
	var trap1 := AadupuliPuzzles.trap_wins(p, 1)
	if trap1.size() == 1:
		found["trap1"].append(_record(p, "trap", 1, trap1[0], 2 if legal.size() <= 10 else 3))
	elif trap1.is_empty() and p.in_hand == 0:
		var trap2 := AadupuliPuzzles.trap_wins(p, 2)
		if trap2.size() == 1:
			found["trap2"].append(_record(p, "trap", 2, trap2[0], 5 if legal.size() >= 12 else 4))


func _record(s: R.State, goal: String, n: int, first: int, difficulty: int) -> Dictionary:
	var goats: Array = []
	for p in R.POINT_COUNT:
		if R.goat_at(s, p):
			goats.append(p)
	return {
		"id": 0, "goal": goal, "n": n, "difficulty": difficulty,
		"tigers": Array(s.tigers), "goats": goats, "in_hand": s.in_hand, "captured": s.captured, "turn": s.turn,
		"answer": first,
	}


func _write(puzzles: Array) -> void:
	var lines := PackedStringArray()
	lines.append("class_name AadupuliPuzzleData")
	lines.append("extends RefCounted")
	lines.append("## Generated by tools/make_puzzles.gd. Do not edit by hand: every puzzle here was")
	lines.append("## proven to have a forced solution with exactly one correct first move (\"answer\").")
	lines.append("## goal: capture | safe | trap; n: moves allowed; turn: 0 goats, 1 tigers.")
	lines.append("")
	lines.append("const PUZZLES := [")
	for p: Dictionary in puzzles:
		lines.append("\t" + JSON.stringify(p) + ",")
	lines.append("]")
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("\n".join(lines) + "\n")
	f.close()
