extends SceneTree
## Generates games/sowing/puzzles/sowing_puzzle_data.gd from self-play positions.
## Every puzzle kept is proven by SowingPuzzles: exactly one right first move.
##   godot --headless --path game -s res://tools/make_sowing_puzzles.gd -- --games=200

const S := preload("res://games/sowing/sowing_rules.gd")
const AI := preload("res://games/sowing/ai/sowing_opponent.gd")
const P := preload("res://games/sowing/puzzles/sowing_puzzles.gd")
const OUT := "res://games/sowing/puzzles/sowing_puzzle_data.gd"
const QUOTA := {"most": 60, "win1": 25, "win2": 25}

var _rng := RandomNumberGenerator.new()


func _init() -> void:
	var games := 200
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--games="):
			games = int(arg.trim_prefix("--games="))
	_rng.seed = 2611
	var t0 := Time.get_ticks_msec()
	var lines := PackedStringArray()
	for id: String in ["kalah", "pallanguzhi"]:
		var set := _make(id, games)
		lines.append('\t"%s": [' % id)
		for p: Dictionary in set:
			lines.append("\t\t%s," % JSON.stringify(p, "", true))
		lines.append("\t],")
	var text := """class_name SowingPuzzleData
extends RefCounted
## Generated by tools/make_sowing_puzzles.gd. Do not edit by hand: every puzzle here was
## proven to have exactly one correct first move ("answer"). You play the bottom row.
## goal: most (win `target` seeds this turn) | win (win the game within n moves).

const PUZZLES := {
%s
}
""" % "\n".join(lines)
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(text)
	f.close()
	print("Wrote %s in %d s" % [OUT, (Time.get_ticks_msec() - t0) / 1000])
	quit()


func _make(id: String, games: int) -> Array:
	var game := S.config_for(id)
	var ai := AI.new(7)
	var seen := {}
	var found := {"most": [], "win1": [], "win2": []}
	for g in games:
		var s := S.new_game(game, g % 2)
		while not s.over:
			var view := _as_bottom(s)
			var key := str(view.pits) + str(view.stores)
			if not seen.has(key):
				seen[key] = true
				_consider(view, found)
			var moves := S.legal_moves(s)
			var m: int = moves[_rng.randi_range(0, moves.size() - 1)]
			if _rng.randf() < 0.7:
				m = ai.choose_move(s, "easy" if _rng.randf() < 0.5 else "medium", 30)
			s = S.after(s, m)
		if _full(found):
			break
	var out: Array = []
	for kind: String in ["most", "win1", "win2"]:
		out.append_array(found[kind])
	out.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return a["difficulty"] < b["difficulty"] if a["difficulty"] != b["difficulty"] else str(a["pits"]) < str(b["pits"]))
	for i in out.size():
		out[i]["id"] = i + 1
	print("%s: %d most, %d win in 1, %d win in 2 (%d positions looked at)" % [
		id, found["most"].size(), found["win1"].size(), found["win2"].size(), seen.size()])
	return out


func _full(found: Dictionary) -> bool:
	for k: String in QUOTA:
		if found[k].size() < QUOTA[k]:
			return false
	return true


## The same position seen from the player to move, so they have the bottom row.
func _as_bottom(s: S.State) -> S.State:
	var v := s.copy()
	if s.turn == 1:
		var n := S.pits_per_side(s)
		var pits := PackedInt32Array()
		for i in s.pits.size():
			pits.append(s.pits[(i + n) % s.pits.size()])
		v.pits = pits
		v.stores = PackedInt32Array([s.stores[1], s.stores[0]])
		v.turn = 0
	return v


func _record(s: S.State, goal: String, n: int, target: int, answer: int, difficulty: int) -> Dictionary:
	return {"goal": goal, "n": n, "target": target, "answer": answer, "difficulty": difficulty,
		"pits": Array(s.pits), "stores": Array(s.stores)}


func _consider(s: S.State, found: Dictionary) -> void:
	var moves := S.legal_moves(s)
	if moves.size() < 3:
		return  # Too few choices to be a puzzle.
	# Most seeds this turn: one clear best first move.
	if found["most"].size() < QUOTA["most"]:
		var gains := {}
		for m in moves:
			gains[m] = P._gain_with(s, m)
		var best := -1
		for m: int in gains:
			best = maxi(best, gains[m])
		var winners: Array = gains.keys().filter(func(m: int) -> bool: return gains[m] == best)
		var second := 0
		for m: int in gains:
			if gains[m] != best:
				second = maxi(second, gains[m])
		if winners.size() == 1 and best >= 4 and best - second >= 3 and P.decided(S.after(s, winners[0]), 0) == 0:
			var chain := _chain_length(s, best)
			var difficulty := clampi(chain + (1 if best >= 10 else 0), 1, 5)
			found["most"].append(_record(s, "most", chain, best, winners[0], difficulty))
	# Win the game: only near the end, where it is quick to prove.
	if P.decided(s, 0) != 0 or s.stores[0] < S.total_seeds(s) / 2 - 14:
		return
	var w1 := P.win_moves(s, 1)
	if w1.size() == 1 and found["win1"].size() < QUOTA["win1"]:
		found["win1"].append(_record(s, "win", 1, 0, w1[0], 2))
	elif w1.is_empty() and found["win2"].size() < QUOTA["win2"]:
		var w2 := P.win_moves(s, 2)
		if w2.size() == 1:
			found["win2"].append(_record(s, "win", 2, 0, w2[0], 4))


## How many moves the best turn takes (Mancala extra turns make it longer).
func _chain_length(s: S.State, need: int) -> int:
	var count := 0
	var cur := s
	var left := need
	while true:
		var good := P.gain_moves(cur, left)
		if good.is_empty():
			break
		var a := S.after(cur, good[0])
		count += 1
		left -= a.stores[0] - cur.stores[0]
		if a.turn != 0 or a.over or left <= 0:
			break
		cur = a
	return count
