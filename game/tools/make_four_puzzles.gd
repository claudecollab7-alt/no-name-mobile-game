extends SceneTree
## Puzzle generator for Four in a Row (BUILD_PLAN.md G4.7). Plays varied computer games
## (a few random opening moves, then search with slips), and keeps only positions where
## FourPuzzles proves exactly one right first move. Writes
## games/fourinrow/puzzles/four_puzzle_data.gd.
##   godot --headless --path game -s res://tools/make_four_puzzles.gd -- --games=400

const F := preload("res://games/fourinrow/four_rules.gd")
const OUT := "res://games/fourinrow/puzzles/four_puzzle_data.gd"
const QUOTA := {"win1": 25, "save_block": 15, "save_deep": 30, "win2": 35, "win3": 25}


func _init() -> void:
	var games := 400
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--games="):
			games = int(arg.trim_prefix("--games="))
	var t0 := Time.get_ticks_msec()
	var rng := RandomNumberGenerator.new()
	rng.seed = 2811
	var ai := FourOpponent.new(17)
	var seen := {}
	var found := {}
	for kind: String in QUOTA:
		found[kind] = []
	var checked := 0
	for g in games:
		var s := F.new_game()
		for i in rng.randi_range(2, 4):
			var opening := F.legal_moves(s)
			F.drop(s, opening[rng.randi_range(0, opening.size() - 1)])
		while F.result(s) == F.ONGOING:
			var key := "%d/%d" % [s.bits[0], s.bits[1]]
			if not seen.has(key):
				seen[key] = true
				checked += 1
				_consider(s, found)
			F.drop(s, ai.search(s, 3 + g % 2, 200, 0.3, 3, true))
		if g % 50 == 49:
			var counts := []
			for kind: String in QUOTA:
				counts.append("%s %d" % [kind, found[kind].size()])
			print("  %d games, %d positions checked: %s (%d s)" % [g + 1, checked, ", ".join(counts), (Time.get_ticks_msec() - t0) / 1000])
	var puzzles: Array = []
	for kind: String in QUOTA:
		var list: Array = found[kind]
		list.shuffle()
		puzzles.append_array(list.slice(0, QUOTA[kind]))
	puzzles.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a["difficulty"] < b["difficulty"])
	for i in puzzles.size():
		puzzles[i]["id"] = i + 1
	_write(puzzles)
	print("Wrote %d puzzles to %s in %d s" % [puzzles.size(), OUT, (Time.get_ticks_msec() - t0) / 1000])
	quit()


func _consider(s: F.State, found: Dictionary) -> void:
	var legal := F.legal_moves(s).size()
	if legal < 4:
		return
	var w1 := FourPuzzles.win_moves(s, 1)
	if not w1.is_empty():
		if w1.size() == 1 and legal >= 5:
			found["win1"].append(_record(s, "win", 1, w1[0], 1))
		return
	var w2 := FourPuzzles.win_moves(s, 2)
	if w2.size() == 1:
		found["win2"].append(_record(s, "win", 2, w2[0], 3))
		return
	if not w2.is_empty():
		return
	var saves := FourPuzzles.save_moves(s)
	if saves.size() == 1:
		var opp_threat := FourPuzzles.win_moves(_their_turn(s), 1).size() > 0
		if opp_threat:
			found["save_block"].append(_record(s, "save", 1, saves[0], 2))
		else:
			found["save_deep"].append(_record(s, "save", 1, saves[0], 3))
	if s.moves_played >= 8:
		var w3 := FourPuzzles.win_moves(s, 3)
		if w3.size() == 1:
			found["win3"].append(_record(s, "win", 3, w3[0], 4 if legal <= 5 else 5))


## The same discs with the other player to move.
func _their_turn(s: F.State) -> F.State:
	var c := s.copy()
	c.turn = 1 - s.turn
	return c


func _record(s: F.State, goal: String, n: int, answer: int, difficulty: int) -> Dictionary:
	return {
		"id": 0, "goal": goal, "n": n, "difficulty": difficulty,
		"columns": F.to_dict(s)["columns"], "turn": s.turn, "answer": answer,
	}


func _write(puzzles: Array) -> void:
	var lines := PackedStringArray()
	lines.append("class_name FourPuzzleData")
	lines.append("extends RefCounted")
	lines.append("## Generated by tools/make_four_puzzles.gd. Do not edit by hand: every puzzle here was")
	lines.append("## proven to have exactly one correct first move (\"answer\"). You play the side to move.")
	lines.append("## goal: win (make four within n moves) | save (the only move that stops a forced four).")
	lines.append("## columns: each column's discs from the bottom up (0 orange, 1 cream).")
	lines.append("")
	lines.append("const PUZZLES := [")
	for p: Dictionary in puzzles:
		lines.append("\t" + JSON.stringify(p) + ",")
	lines.append("]")
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("\n".join(lines) + "\n")
	f.close()
