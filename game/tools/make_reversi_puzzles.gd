extends SceneTree
## Puzzle generator for Reversi (BUILD_PLAN.md G5.7). Plays varied computer games (a few
## random opening moves, then short searches with slips and the odd random move), and
## keeps only positions where ReversiPuzzles proves exactly one right first move. Writes
## games/reversi/puzzles/reversi_puzzle_data.gd.
##   godot --headless --path game -s res://tools/make_reversi_puzzles.gd -- --games=300

const R := preload("res://games/reversi/reversi_rules.gd")
const OUT := "res://games/reversi/puzzles/reversi_puzzle_data.gd"
## Kinds, easiest first: [goal, fewest empty squares, most empty squares, difficulty, how many].
const KINDS := {
	"pass": ["pass", 1, 60, 1, 25],
	"win_short": ["win", 4, 6, 2, 30],
	"win_mid": ["win", 7, 8, 3, 30],
	"win_long": ["win", 9, 10, 4, 25],
	"win_longest": ["win", 11, 12, 5, 20],
}

var _rng := RandomNumberGenerator.new()


func _init() -> void:
	var games := 300
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--games="):
			games = int(arg.trim_prefix("--games="))
	var t0 := Time.get_ticks_msec()
	_rng.seed = 5201
	var ai := ReversiOpponent.new(19)
	var seen := {}
	var found := {}
	for kind: String in KINDS:
		found[kind] = []
	var checked := 0
	for g in games:
		var s := R.new_game()
		for i in _rng.randi_range(2, 8):
			var opening := R.legal_moves(s)
			R.play(s, opening[_rng.randi_range(0, opening.size() - 1)])
		while R.result(s) == R.ONGOING:
			var key := "%d/%d/%d" % [s.bits[0], s.bits[1], s.turn]
			if not seen.has(key):
				seen[key] = true
				checked += 1
				_consider(s, found)
			var legal := R.legal_moves(s)
			if _rng.randf() < 0.15:
				R.play(s, legal[_rng.randi_range(0, legal.size() - 1)])
			else:
				R.play(s, ai.search(s, 2, 100, 0.25, 3))
		if g % 25 == 24:
			var counts := []
			for kind: String in KINDS:
				counts.append("%s %d" % [kind, found[kind].size()])
			print("  %d games, %d positions checked: %s (%d s, %d proof positions)" % [
				g + 1, checked, ", ".join(counts), floori((Time.get_ticks_msec() - t0) / 1000.0), ReversiPuzzles.nodes])
			if _full(found):
				break
	var puzzles: Array = []
	for kind: String in KINDS:
		var list: Array = found[kind]
		_shuffle(list)
		puzzles.append_array(list.slice(0, int(KINDS[kind][4])))
	puzzles.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return a["difficulty"] < b["difficulty"] or (a["difficulty"] == b["difficulty"] and a["empties"] < b["empties"]))
	for i in puzzles.size():
		puzzles[i]["id"] = i + 1
	_write(puzzles)
	print("Wrote %d puzzles to %s in %d s" % [puzzles.size(), OUT, floori((Time.get_ticks_msec() - t0) / 1000.0)])
	quit()


func _full(found: Dictionary) -> bool:
	for kind: String in KINDS:
		if found[kind].size() < int(KINDS[kind][4]) * 2:  # Twice the quota, to choose from.
			return false
	return true


func _shuffle(list: Array) -> void:
	for i in range(list.size() - 1, 0, -1):
		var j := _rng.randi_range(0, i)
		var t: Variant = list[i]
		list[i] = list[j]
		list[j] = t


func _consider(s: R.State, found: Dictionary) -> void:
	var legal := R.legal_moves(s)
	if legal.size() < 3 or legal[0] == R.PASS:
		return
	var e := ReversiPuzzles.empties(s)
	var pass_list: Array = found["pass"]
	if pass_list.size() < int(KINDS["pass"][4]) * 2:
		var passes := ReversiPuzzles.pass_moves(s)
		if passes.size() == 1:
			pass_list.append(_record(s, "pass", passes[0], 1))
	for kind: String in KINDS:
		var k: Array = KINDS[kind]
		if k[0] != "win" or e < int(k[1]) or e > int(k[2]) or found[kind].size() >= int(k[4]) * 2:
			continue
		var wins := ReversiPuzzles.win_moves(s)
		if wins.size() == 1:
			found[kind].append(_record(s, "win", wins[0], int(k[3])))


func _record(s: R.State, goal: String, answer: int, difficulty: int) -> Dictionary:
	return {
		"id": 0, "goal": goal, "difficulty": difficulty, "empties": ReversiPuzzles.empties(s),
		"rows": R.to_dict(s)["rows"], "turn": s.turn, "answer": answer,
	}


func _write(puzzles: Array) -> void:
	var lines := PackedStringArray()
	lines.append("class_name ReversiPuzzleData")
	lines.append("extends RefCounted")
	lines.append("## Generated by tools/make_reversi_puzzles.gd. Do not edit by hand: every puzzle here was")
	lines.append("## proven to have exactly one correct first move (\"answer\"). You play the side to move.")
	lines.append("## goal: pass (the only move that leaves them nowhere to play) | win (win the ending).")
	lines.append("## rows: the board from the bottom up (\".\" empty, \"0\" orange, \"1\" cream).")
	lines.append("")
	lines.append("const PUZZLES := [")
	for p: Dictionary in puzzles:
		lines.append("\t" + JSON.stringify(p) + ",")
	lines.append("]")
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("\n".join(lines) + "\n")
	f.close()
